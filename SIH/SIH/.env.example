# Application
APP_ENV=development
DEMO_MODE=true
FRONTEND_ORIGIN=http://localhost:5173

# Data: use sqlite for the guaranteed local path, or supabase for hosted Postgres.
DATA_BACKEND=sqlite
DATABASE_URL=sqlite:///./backend/data/nwis.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nwis-documents
LOCAL_STORAGE_PATH=backend/data/storage

# AI provider (backend only; never prefix these with VITE_)
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
GEMINI_COPILOT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768

# Look-ahead configuration
LOOKAHEAD_WINDOW_M=150
WATCH_THRESHOLD=0.45
ELEVATED_THRESHOLD=0.65
LIVE_CORROBORATION_THRESHOLD=0.50

# Map provider (safe to expose to the frontend; no secret token)
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_API_BASE_URL=http://localhost:8000
VITE_OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Failure-smoke test seam; leave false for normal WebSocket-first operation.
VITE_FORCE_REST=false
